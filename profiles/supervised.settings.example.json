{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "ask": ["Bash", "Monitor", "WebFetch", "WebSearch", "mcp__*", "Agent"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./CLAUDE.local.md)",
      "Write(./CLAUDE.local.md)",
      "Edit(./AGENTS.md)",
      "Write(./AGENTS.md)",
      "Edit(./PERSONAL.md)",
      "Write(./PERSONAL.md)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "network": {"allowedDomains": []}
  }
}
